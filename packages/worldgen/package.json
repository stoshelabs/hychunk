{
  "name": "@hychunk/worldgen",
  "version": "0.0.1",
  "description": "A TypeScript port of Hytale's default world generator, to predict terrain that has not been explored yet.",
  "keywords": [
    "hytale",
    "worldgen",
    "noise",
    "seed",
    "terrain"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Stoshe Labs",
  "homepage": "https://github.com/stoshelabs/hychunk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoshelabs/hychunk.git",
    "directory": "packages/worldgen"
  },
  "bugs": "https://github.com/stoshelabs/hychunk/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE.GPL"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  }
}
